APP_NAME="RentManager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentmanager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@rentmanager.test"
MAIL_FROM_NAME="${APP_NAME}"

# RentManager demo credentials
RENTMANAGER_DEMO_EMAIL=demo@rentmanager.test
RENTMANAGER_DEMO_PASSWORD=password
RENTMANAGER_DEFAULT_ADMIN_EMAIL=admin@rentmanager.test
RENTMANAGER_DEFAULT_ADMIN_PASSWORD=password

# Payment Gateways (mock - leave empty to use mock)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_KEY=
STRIPE_SECRET=

# Storage disk
RENTMANAGER_STORAGE_DISK=public

VITE_APP_NAME="${APP_NAME}"
